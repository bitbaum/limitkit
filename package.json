{
  "name": "limitkit",
  "version": "0.1.0",
  "description": "Rate limiting as a decision, not a middleware: fixed and sliding windows over an injectable store, a bounded in-memory store, standard RateLimit headers, and client-IP extraction. No HTTP client, no framework.",
  "license": "MIT",
  "author": "Mao Nakamoto",
  "homepage": "https://github.com/maonakamoto/limitkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maonakamoto/limitkit.git"
  },
  "bugs": {
    "url": "https://github.com/maonakamoto/limitkit/issues"
  },
  "keywords": [
    "rate-limit",
    "rate-limiting",
    "sliding-window",
    "fixed-window",
    "throttle",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0"
  }
}
