{
  "name": "limitkit",
  "version": "0.2.0",
  "description": "Rate limiting as a decision, not a middleware: fixed and sliding windows over an injectable store, a bounded in-memory store, standard RateLimit headers, and client-IP extraction. No HTTP client, no framework.",
  "license": "MIT",
  "author": "Mao Nakamoto",
  "homepage": "https://github.com/catomean/limitkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catomean/limitkit.git"
  },
  "bugs": {
    "url": "https://github.com/catomean/limitkit/issues"
  },
  "keywords": [
    "rate-limit",
    "rate-limiting",
    "sliding-window",
    "fixed-window",
    "throttle",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "prettier": "3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.68.0"
  }
}
